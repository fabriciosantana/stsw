      "type": "http",
      "documentation": "Exemplo 2: Cadastro de Livro com Regra Condicional (Preço > 500 ➔ 422 / Sucesso ➔ 201)",
      "method": "post",
      "endpoint": "livros",
      "responses": [
        {
          "uuid": "8226a9e6-ca38-4881-afb7-c03ac2ef4c0b",
          "body": "{\n  \"erro\": \"PRECO_EXCESSIVO\",\n  \"mensagem\": \"Não é permitido cadastrar livros com valor superior a R$ 500.00\",\n  \"precoEnviado\": {{body 'preco'}}\n}",
          "latency": 0,
          "statusCode": 422,
          "label": "422 Unprocessable Entity - Preço > 500",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "bodyType": "INLINE",
          "filePath": "",
          "databucketID": "",
          "sendFileAsBody": false,
          "rules": [
            {
              "target": "body",
              "operator": "regex",
              "value": "^(50[1-9]|5[1-9]\\d|[6-9]\\d{2}|\\d{4,})",
              "invert": false,
              "modifier": "preco"
            }
          ],
          "rulesOperator": "AND",
          "disableTemplating": false,
          "fallbackTo404": false,
          "default": false,
          "crudKey": "id",
          "callbacks": []
        },
        {
          "uuid": "9226a9e6-ca38-4881-afb7-c03ac2ef4c0c",
          "body": "{\n  \"status\": \"LIVRO_CADASTRADO\",\n  \"codigoLivro\": \"LIV-{{faker 'string.alphanumeric' 8}}\",\n  \"preco\": {{body 'preco'}},\n  \"dataCadastro\": \"{{now}}\"\n}",
          "latency": 50,
          "statusCode": 201,
          "label": "201 Created - Sucesso Preço <= 500",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
